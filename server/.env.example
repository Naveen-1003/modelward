# Copy to server/.env and edit. Never commit the real file (.env is git-ignored).
# Everything is read through config/env.js. Values below are placeholders only.

# ---- Core ----------------------------------------------------------------
# development | production | test. Production turns on strict startup checks.
NODE_ENV=development
# HTTP port. Render injects its own in production -- leave unset there.
PORT=5000
# Local MongoDB. In production use an Atlas URI that includes the database name.
MONGO_URI=mongodb://127.0.0.1:27017/modelward
# Signs login tokens. Production requires >= 32 random characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# How long a login token stays valid: seconds (3600) or a number + s|m|h|d (12h, 7d).
JWT_EXPIRES_IN=12h

# ---- Security ------------------------------------------------------------
# Comma-separated browser origins allowed by CORS (exact, no trailing slash).
# Unset in development = any localhost origin works.
CLIENT_ORIGIN=http://localhost:5173
# Reverse proxies in front of the app. Number = hop count (Render: 1); "loopback" /
# CIDR lists are accepted; true/false map to booleans. Avoid "true" in production
# (it trusts a client-supplied X-Forwarded-For). Leave unset locally. Invalid values
# fail startup validation. See DEPLOYMENT.md "Behind a proxy".
# TRUST_PROXY=1
# Pickle/joblib uploads execute code on the metrics service. Default: on in dev, off in production.
ALLOW_MODEL_FILES=true

# ---- Audit log integrity -------------------------------------------------
# Optional. When set (>= 16 random chars), NEW audit entries are chained with
# HMAC-SHA256 instead of plain SHA-256, so someone with database write access but not
# this key cannot rewrite the log consistently. Older sha256 entries keep verifying.
# If the key is changed or lost, every hmac entry FAILS verification -- keep it stable
# and backed up. LIMIT: deleting the newest entries (tail truncation) is NOT detectable
# from the database alone, with or without a key. Record the "head" returned by
# GET /api/audit-log/verify somewhere outside the database and re-check it with
# ?expectedHeadSeq=N&expectedHeadHash=<hash>.
# AUDIT_HMAC_KEY=

# ---- Metrics service -----------------------------------------------------
# Where the FastAPI scoring service lives.
METRICS_SERVICE_URL=http://127.0.0.1:8000
# Shared secret sent as X-Metrics-Secret. Must match the metrics service. Required in production.
METRICS_SHARED_SECRET=
# Per-request timeout when calling the metrics service.
METRICS_TIMEOUT_MS=90000
# How long to poll /health for a sleeping (Render free tier) metrics service. 0 = don't wait (dev default; production default 60000).
METRICS_WAKE_TIMEOUT_MS=0

# ---- Storage -------------------------------------------------------------
# local = keep uploads on disk (downloadable, retry-able). discard = delete after scoring (production default).
STORAGE_MODE=local
# Where uploads are kept when STORAGE_MODE=local. Defaults to server/uploads.
# UPLOAD_DIR=./uploads
# Days before the retention job deletes retained files of archived / upload_failed versions (database rows are kept).
RETENTION_DAYS=30

# ---- Limits --------------------------------------------------------------
# Max size of one uploaded file, in MB (larger = 413).
MAX_UPLOAD_MB=25
# Failed logins allowed per IP (IPv6: per /64) within the window before 429.
LOGIN_MAX_FAILURES=10
# Failed logins allowed per ACCOUNT (normalized email, unknown emails count too) in the same window.
LOGIN_ACCOUNT_MAX_FAILURES=10
LOGIN_WINDOW_MINUTES=15
# Signups allowed per IP per hour.
SIGNUP_MAX_PER_HOUR=20
# General API requests allowed per IP per minute.
API_MAX_PER_MINUTE=600
# Lets any signed-in user add simulated drift snapshots. Set false to allow only real monitoring batches.
ENABLE_DRIFT_SIMULATION=true

# ---- Signup / roles ------------------------------------------------------
# Self-signup as ml_engineer is open. admin / compliance_officer require these codes.
# Production requires >= 16 characters and rejects placeholder-looking values (replace, change-me, example, secret) -- the values below are templates, replace them.
# Unset = that role cannot self-register (an admin can still create the user).
ADMIN_INVITE_CODE=change-me-admin-invite
COMPLIANCE_INVITE_CODE=change-me-compliance-invite
