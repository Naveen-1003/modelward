# ModelWard metrics service (FastAPI). Copy to .env or set these in your host's dashboard.
# Start: uvicorn main:app --host 0.0.0.0 --port $PORT
# The service reads real environment variables only; it does not load .env files itself.

# "production" => METRICS_SHARED_SECRET is mandatory (the app refuses to start without it)
# and ALLOW_MODEL_FILES defaults to false.
APP_ENV=development

# Shared secret the Express server sends in the X-Metrics-Secret header
# (must equal the server's METRICS_SHARED_SECRET). Empty = no check (local dev only).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_SHARED_SECRET=

# Accept .pkl/.pickle/.joblib model files? Default: true unless APP_ENV=production.
# Unpickling untrusted files is risky even with the allow-list + subprocess isolation here;
# false (CSV-only) is the safest production setting.
ALLOW_MODEL_FILES=true

# Max size of EACH uploaded file in bytes (default 25 MB). Larger => HTTP 413.
MAX_UPLOAD_BYTES=26214400

# Scoring validation (violations => HTTP 400 with a clear message)
METRICS_MIN_ROWS=30
METRICS_MIN_GROUP_ROWS=10
METRICS_MAX_ROWS=200000

# Each scoring runs in a child process killed after this many seconds (=> HTTP 400 "timed out").
SCORING_TIMEOUT_SECONDS=60

# Address-space limit for the scoring child, in MB. Linux only (ignored on Windows); 0 disables.
SCORING_MAX_MEMORY_MB=2048

# Extra (not in the shared contract): max scoring child processes running at once; further
# requests wait up to SCORING_TIMEOUT_SECONDS, then get HTTP 503 (retryable). Default 2.
SCORING_MAX_CONCURRENT=2
